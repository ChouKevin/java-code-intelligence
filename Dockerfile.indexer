FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY semantic-model/pom.xml semantic-model/pom.xml
COPY semantic-indexer/pom.xml semantic-indexer/pom.xml
COPY semantic-query/pom.xml semantic-query/pom.xml
RUN mvn --batch-mode --no-transfer-progress -pl semantic-indexer -am dependency:go-offline
COPY semantic-model semantic-model
COPY semantic-query semantic-query
COPY semantic-indexer semantic-indexer
RUN mvn --batch-mode --no-transfer-progress -pl semantic-indexer -am -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jdk
RUN apt-get update && apt-get install -y --no-install-recommends curl git util-linux \
    && groupadd --gid 10001 analysis \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/analysis --shell /usr/sbin/nologin analysis \
    && mkdir -p /data/repos /data/jdtls \
    && chown -R analysis:analysis /data /home/analysis \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-jdtls.sh /usr/local/bin/install-jdtls
RUN /usr/local/bin/install-jdtls /opt/jdtls
ENV JDTLS_JAVA_EXECUTABLE=/opt/java/openjdk/bin/java \
    JDTLS_ISOLATION_MODE=LINUX_UID \
    JDTLS_ANALYSIS_UID=10001 \
    JDTLS_ANALYSIS_GID=10001 \
    JDTLS_ANALYSIS_HOME=/home/analysis
WORKDIR /app
COPY --from=build /workspace/semantic-indexer/target/semantic-indexer-0.0.1-SNAPSHOT.jar /app/semantic-indexer.jar
VOLUME ["/data/repos", "/data/jdtls"]
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/semantic-indexer.jar"]
