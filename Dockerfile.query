FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY semantic-model/pom.xml semantic-model/pom.xml
COPY semantic-indexer/pom.xml semantic-indexer/pom.xml
COPY semantic-query/pom.xml semantic-query/pom.xml
RUN mvn --batch-mode --no-transfer-progress -pl semantic-query -am dependency:go-offline
COPY semantic-model semantic-model
COPY semantic-query semantic-query
RUN mvn --batch-mode --no-transfer-progress -pl semantic-query -am -DskipTests package

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep \
    && groupadd --gid 10002 source-reader \
    && useradd --uid 10002 --gid 10002 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin source-reader \
    && mkdir -p /data/source-published /data/index-published /tmp/sqlite-native \
    && chown source-reader:source-reader /tmp/sqlite-native \
    && chmod 0700 /tmp/sqlite-native \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /workspace/semantic-query/target/semantic-query-0.0.1-SNAPSHOT-exec.jar /app/semantic-query.jar
# Immutable databases remain read-only; only native-library extraction is writable.
ENV JAVA_TOOL_OPTIONS="-Dorg.sqlite.tmpdir=/tmp/sqlite-native"
USER 10002:10002
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/semantic-query.jar"]
