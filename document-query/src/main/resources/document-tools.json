[
  {
    "name": "search_documents",
    "description": "Search NOT_VERIFIED navigation using a case-sensitive literal substring, not source evidence. Optionally scope to repositoryId; absence searches the latest independent owner publications globally. Hits are ordered by full literal path and original section start, each with its own owner-bound documentContext. Read complete documents before independently verifying source. No hit is not proof of absence: discover source repositories and investigate exact source pins. Repeat query, limit and scope with a cursor. Global cursors expire on any effective owner change; scoped cursors expire only on that owner's change. Restart search on DOCUMENT_REVISION_NOT_AVAILABLE. Source historical reads are unchanged.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S",
          "description": "Nonblank literal text, preserved without trimming; length is Unicode code points."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Process-authenticated continuation, at most 4096 UTF-8 bytes. Repeat the same query, requested limit and repository scope."
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "Optional business repository owner; an unpublished valid owner returns no hits."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "documentRepositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "collectionPurpose": {
              "type": "string",
              "enum": [
                "TEST_ONLY",
                "APPROVED"
              ]
            },
            "trust": {
              "type": "string",
              "enum": [
                "NOT_VERIFIED"
              ]
            },
            "publicationStatus": {
              "type": "string",
              "enum": [
                "READY",
                "UPDATE_REJECTED"
              ]
            },
            "publicationErrorCode": {
              "type": "string",
              "enum": [
                "DOCUMENT_CATALOG_INVALID",
                "DOCUMENT_CAPACITY_EXCEEDED",
                "DOCUMENT_UNAVAILABLE"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hit"
              },
              "maxItems": 20
            },
            "page": {
              "type": "object",
              "properties": {
                "returned": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "hasMore": {
                  "type": "boolean"
                },
                "nextCursor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Process-authenticated continuation, at most 4096 UTF-8 bytes. Repeat the same query, requested limit and repository scope."
                }
              },
              "required": [
                "returned",
                "hasMore"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "documentRepositoryId",
            "collectionPurpose",
            "trust",
            "publicationStatus",
            "items",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/error"
        }
      ],
      "$defs": {
        "documentContext": {
          "type": "object",
          "properties": {
            "documentRepositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "documentRevision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "minLength": 40,
              "maxLength": 40
            }
          },
          "required": [
            "documentRepositoryId",
            "repositoryId",
            "documentRevision"
          ],
          "additionalProperties": false
        },
        "sourceContext": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "minLength": 40,
              "maxLength": 40
            }
          },
          "required": [
            "repositoryId",
            "revision"
          ],
          "additionalProperties": false
        },
        "section": {
          "type": "object",
          "properties": {
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "titleTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "startLine",
            "title",
            "titleTruncated"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENT",
                "DOCUMENT_REPOSITORY_NOT_FOUND",
                "DOCUMENT_REVISION_NOT_AVAILABLE",
                "DOCUMENT_NOT_FOUND",
                "DOCUMENT_SECTION_NOT_FOUND",
                "DOCUMENT_CATALOG_INVALID",
                "DOCUMENT_CAPACITY_EXCEEDED",
                "DOCUMENT_RESULT_TOO_LARGE",
                "DOCUMENT_BUSY",
                "DOCUMENT_TIMEOUT",
                "DOCUMENT_UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "hit": {
          "type": "object",
          "properties": {
            "documentContext": {
              "$ref": "#/$defs/documentContext"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Literal catalog path, at most 512 UTF-8 bytes; no suffix selectors or control-file access."
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "primaryContext": {
              "$ref": "#/$defs/sourceContext"
            },
            "relatedContexts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceContext"
              },
              "maxItems": 32
            },
            "reviewStatus": {
              "type": "string",
              "enum": [
                "DRAFT",
                "APPROVED"
              ]
            },
            "reviewReference": {
              "type": "string",
              "maxLength": 262144,
              "description": "Review reference admitted within the 256 KiB catalog and complete result budget; not proof of source correctness."
            },
            "collectionPurpose": {
              "type": "string",
              "enum": [
                "TEST_ONLY",
                "APPROVED"
              ]
            },
            "trust": {
              "type": "string",
              "enum": [
                "NOT_VERIFIED"
              ]
            },
            "snippet": {
              "type": "string",
              "maxLength": 240
            },
            "snippetTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "documentContext",
            "path",
            "contentDigest",
            "section",
            "primaryContext",
            "relatedContexts",
            "reviewStatus",
            "collectionPurpose",
            "trust",
            "snippet",
            "snippetTruncated"
          ],
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read_document",
    "description": "Read the complete bounded Markdown at the exact current owner-bound documentContext, literal catalog path and original sectionStartLine copied from a hit. Returns original bytes as UTF-8 text including qualifications, tables, fences, CRLF and EOF. Cite documentRepositoryId@fullDocumentRevision:path#L<sectionStartLine>; verify business claims with independently pinned source evidence. Updating/removing this owner invalidates old locators even if Git preserves the blob; changes to other owners do not invalidate this read. Never retarget context or section lines to a new document. Repeat search on DOCUMENT_REVISION_NOT_AVAILABLE. All documents remain NOT_VERIFIED navigation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentContext": {
          "type": "object",
          "properties": {
            "documentRepositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "documentRevision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "minLength": 40,
              "maxLength": 40
            }
          },
          "required": [
            "documentRepositoryId",
            "repositoryId",
            "documentRevision"
          ],
          "additionalProperties": false
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Literal catalog path, at most 512 UTF-8 bytes; no suffix selectors or control-file access."
        },
        "sectionStartLine": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "documentContext",
        "path",
        "sectionStartLine"
      ],
      "additionalProperties": false
    },
