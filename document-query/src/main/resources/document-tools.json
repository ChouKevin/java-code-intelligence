            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Lossless entire document, at most 64 KiB UTF-8; no summary, elision or duplicated section body."
            }
          },
          "required": [
            "documentContext",
            "path",
            "contentDigest",
            "section",
            "primaryContext",
            "relatedContexts",
            "reviewStatus",
            "collectionPurpose",
            "trust",
            "publicationStatus",
            "blobId",
            "byteLength",
