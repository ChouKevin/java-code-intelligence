            },
            "relatedContexts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceContext"
              },
              "maxItems": 32
            },
            "reviewStatus": {
              "type": "string",
              "enum": [
                "DRAFT",
                "APPROVED"
              ]
            },
            "reviewReference": {
              "type": "string",
              "maxLength": 262144,
              "description": "Review reference admitted within the 256 KiB catalog and complete result budget; not proof of source correctness."
            },
            "collectionPurpose": {
              "type": "string",
              "enum": [
                "TEST_ONLY",
                "APPROVED"
              ]
            },
            "trust": {
              "type": "string",
              "enum": [
                "NOT_VERIFIED"
              ]
            },
            "publicationStatus": {
              "type": "string",
              "enum": [
