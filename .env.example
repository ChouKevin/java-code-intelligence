# This template contains configuration names only. Put values in chmod-600 ignored
# secret files or the deployment secret store; do not commit a populated .env.
# SEMANTIC_API_TOKEN is for deployed acceptance clients, not the Query server.
SEMANTIC_API_TOKEN=

# Indexer runtime: Mongo writer identity, private admin token, and read-only Git.
SEMANTIC_MONGODB_URI=mongodb://semantic-index-writer:<secret>@mongo.private/semantic?tls=true
SEMANTIC_INDEXER_ADMIN_TOKEN=<secret-file:/run/secrets/indexer-admin-token>
GIT_USERNAME=<secret-file:/run/secrets/git-username>
GIT_TOKEN=<secret-file:/run/secrets/git-read-token>
SEMANTIC_DATA_ROOT=/srv/semantic/indexer/checkouts

# Query runtime: a different Mongo read identity and Query-only bearer token.
# In Query's separate env file, set SEMANTIC_MONGODB_URI to:
# mongodb://semantic-query-reader:<secret>@mongo.private/semantic?tls=true
SEMANTIC_QUERY_API_TOKEN=<secret-file:/run/secrets/query-read-token>
SERVER_SSL_ENABLED=true
SERVER_SSL_CERTIFICATE=file:/run/secrets/query.crt
SERVER_SSL_CERTIFICATE_PRIVATE_KEY=file:/run/secrets/query.key

# Indexer JDT LS isolation and measured-RSS sizing inputs.
# Container sizing: size from RSS, not from JDTLS_MAX_HEAP. The spike measured
# 1,030,328 KiB at -Xmx768m and 1,045,700 KiB at -Xmx2g for a trivial workspace;
# this is an Equinox/OSGi/JDK baseline, so heap size barely changed resident use.
# At two workspaces the measured trivial floor is about 2 GiB before Indexer,
# Query, Mongo, and VM headroom. Heap adequacy itself is unmeasured.
JDTLS_ENABLED=true
JDTLS_HOME=/opt/jdtls
JDTLS_WORKSPACE_DATA_ROOT=/srv/semantic/indexer/jdtls
JDTLS_JAVA_EXECUTABLE=/opt/java/openjdk/bin/java
JDTLS_ISOLATION_MODE=LINUX_UID
JDTLS_ANALYSIS_UID=10001
JDTLS_ANALYSIS_GID=10001
JDTLS_ANALYSIS_HOME=/home/analysis
JDTLS_STARTUP_TIMEOUT=180s
JDTLS_IMPORT_TIMEOUT=900s
JDTLS_REQUEST_TIMEOUT=30s
JDTLS_MAX_ACTIVE_WORKSPACES=2
JDTLS_IDLE_TIMEOUT=30m
JDTLS_MAINTENANCE_INTERVAL=1m
JDTLS_MAX_HEAP=2g

# Configure approved sources in application YAML, not through an unaudited
# environment blob:
# semantic.repositories.<repositoryId>.url=<read-only Git URL>
# semantic.repositories.<repositoryId>.default-branch=main
# semantic.query.git-evidence.allowed-repositories=[<approved repository IDs>]
