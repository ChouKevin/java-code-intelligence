SEMANTIC_API_TOKEN=
GIT_USERNAME=your-email@example.com
GIT_TOKEN=your-personal-access-token
REPO_TEST_FIXTURE_PATH=/data/fixtures/test-repo
# Container sizing: size from RSS, NOT from JDTLS_MAX_HEAP.
# The spike measured ~1 GB resident per workspace regardless of heap:
# 1,030,328 kb at -Xmx768m vs 1,045,700 kb at -Xmx2g. The footprint is JDT LS's
# Equinox/OSGi and JDK-index baseline, not the workload, so the flag barely moves it.
# At JDTLS_MAX_ACTIVE_WORKSPACES=2 the floor is ~2 GB RSS for two trivial repositories.
# Sizing a container from 2 x 768m = 1.5 GB OOMs on startup.
# Heap adequacy itself is UNMEASURED: the spike's fixture never approached either limit.
# The metric jdtls.workspace.peak.rss.kilobytes{repository} reports the child's VmHWM;
# let a real import set the number before trusting any heap value.
JDTLS_ENABLED=true
JDTLS_HOME=/opt/jdtls
JDTLS_WORKSPACE_DATA_ROOT=/data/jdtls
JDTLS_STARTUP_TIMEOUT=180s
JDTLS_IMPORT_TIMEOUT=900s
JDTLS_REQUEST_TIMEOUT=30s
JDTLS_MAX_ACTIVE_WORKSPACES=2
JDTLS_IDLE_TIMEOUT=30m
JDTLS_MAX_HEAP=2g
