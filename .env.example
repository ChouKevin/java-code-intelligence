# Use separate Indexer and Query environments. Values here are examples, NOT
# credentials; inject each token from a deployment secret store at runtime.
# Never mount the Indexer environment, Git credentials, or /data/source-admin
# into Query. /data is one service-owned mount in Indexer, not two volumes.
#
# Bootstrap a NEW host directory for Indexer (UID:GID 10001:10001, mode 0700)
# with a source-published child (UID:GID 10001:10001, mode 0755).
# Indexer: --mount type=bind,src=<new-service-root>,dst=/data
# Query:   --mount type=bind,src=<new-service-root>/source-published,dst=/data/source-published,readonly
# The published child only is visible to Query (UID:GID 10002:10002).
# Mount an approved read-only Git source only into Indexer, if local Git is used.

# Indexer-only environment (private HTTP/MCP /index and /mcp):
SEMANTIC_INDEXER_ADMIN_TOKEN=
SEMANTIC_SOURCE_ADMIN_ROOT=/data/source-admin
SEMANTIC_SOURCE_PUBLISHED_ROOT=/data/source-published
# Policy-2 fresh namespaces only. Retirement is fixed at 30 elapsed days after replacement.
SEMANTIC_SOURCE_RETENTION_ENABLED=true
SEMANTIC_SOURCE_RETENTION_INTERVAL=24h
GIT_USERNAME=
GIT_TOKEN=
# Configure each approved source with semantic.repositories.<id>.url,
# .default-branch, .display-name and optional .project-guide-path in Indexer
# configuration. Guide validation does not block source preparation.

# Query-only environment (HTTP /api/v1 and read MCP /mcp):
SEMANTIC_QUERY_API_TOKEN=
SEMANTIC_SOURCE_PUBLISHED_ROOT=/data/source-published
SEMANTIC_QUERY_RG_EXECUTABLE=/usr/bin/rg
# Set semantic.query.source.allowed-repositories to an explicit list of
# approved repository IDs (e.g. in Query configuration or SPRING_APPLICATION_JSON).
# Empty list denies every repository. Query has no Git/admin or Indexer token.
